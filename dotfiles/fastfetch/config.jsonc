{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    {
      "type": "title",
      "key": " ",
      "keyColor": "green",
      "format": "{user-name}",
    },
    {
      "type": "title",
      "key": "󱋆 ",
      "keyColor": "green",
      "format": "{host-name}",
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "green",
    },
    {
      "type": "locale",
      "key": " ",
      "keyColor": "green",
    },
    {
      "type": "os",
      "key": "󰇄 ",
      "keyColor": "green",
      "format": "{name} {version}",
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "green",
    },
{
      "type": "cpu",
      "key": "󰍛 ",
      "keyColor": "yellow",
      "format": "{name}",
    },
    {
      "type": "gpu",
      "key": "󰘚 ",
      "keyColor": "yellow",
      "format": "{name}",
    },
    {
      "type": "localip",
      "key": "󰩟 ",
      "keyColor": "yellow",
      "format": "{ipv4} ({ifname})",
    },
{
      "type": "memory",
      "key": " ",
      "keyColor": "cyan",
      "percentColor": {
        "0": "green",
        "25": "yellow",
        "75": "red",
      },
    },
    {
      "type": "swap",
      "key": "󰾵 ",
      "keyColor": "cyan",
      "percentColor": {
        "0": "green",
        "25": "yellow",
        "75": "green",
      },
    },
    {
      "type": "disk",
      "key": "󰉉 ",
      "keyColor": "cyan",
      "folders": "/",
      "percentColor": {
        "0": "green",
        "50": "yellow",
        "75": "red",
      },
    },
{
      "type": "battery",
      "key": "󱊥 ",
      "keyColor": "cyan",
      "percentColor": {
        "0": "red",
        "25": "yellow",
        "75": "green",
      },
    },
    {
      "type": "uptime",
      "key": "󰅐 ",
      "keyColor": "cyan",
    },
  ],
  "logo": {
    "type": "auto",
    "source": "nixos_small",
    // "type": "file",
    // "source": "/home/slaven/.config/fastfetch/RPandaASCII.txt",
    "color": {
      "1": "green",
      "2": "cyan"
    },
  },
}
